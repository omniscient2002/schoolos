# Frontend demo affordances (P0 audit fix 2a): the Login role-grid,
# /demo* + /live routes and the "Switch demo role" menu render ONLY
# when this flag is '1'. Vite loads .env.development only for
# development mode, so `npm run build` (production) ships with NO demo
# UI even though DEMO_PASSWORD stays in code. To exercise demo UI in a
# production build explicitly: VITE_DEMO_MODE=1 npm run build.
VITE_DEMO_MODE=1
