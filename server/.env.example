# ────────────────────────────────────────────────────────────────────────────────
# SchoolOS API — environment template. Copy to server/.env and fill in.
# Every value here is read by server/src/config.js (or app.js) at boot.
# NEVER commit a real .env — .gitignore already excludes it.
# ────────────────────────────────────────────────────────────────────────────────

# ── Core server ─────────────────────────────────────────────────────────────────
# development | production. production boots fail-fast: refuses localhost
# DATABASE_URL, "*" CORS, missing/short JWT_SECRET, and non-strict SEED_GUARD.
NODE_ENV=development
PORT=8080
HOST=0.0.0.0
LOG_LEVEL=info

# ── Postgres ────────────────────────────────────────────────────────────────────
# App connection (used by the server pool and the migration runner).
DATABASE_URL=postgres://schoolos:schoolos_dev_pw@127.0.0.1:5432/schoolos
# Owner-role URL for scripts/bootstrap.js (installs roles/grants). Defaults to
# DATABASE_URL when unset — override only when the owner role lives elsewhere.
ADMIN_DATABASE_URL=postgres://postgres@127.0.0.1:5432/postgres

# ── Auth ────────────────────────────────────────────────────────────────────────
# REQUIRED ≥32 chars outside development (dev default: dev-only-secret-change-me).
JWT_SECRET=change-me-to-a-32+-char-random-secret
# Access-token lifetime (e.g. 12h) and the intentionally short student-session
# lifetime for shared lab computers (StudentOS §62/§63/§78).
JWT_TTL=12h
STUDENT_SESSION_TTL=30m
# Comma-separated allowlist, e.g. https://app.schoolos.example,https://admin.… .
# "*" is dev-only; production refuses it.
CORS_ORIGINS=*
# Max requests/min per identity for the rate limiter.
RATE_LIMIT_MAX=300
# Set true ONLY behind a reverse proxy that sets X-Forwarded-For, so rate limiting
# keys on the real client IP instead of the proxy's.
TRUST_PROXY=false
# TLS terminates at the proxy. Set true ONLY when the proxy actually enforces
# HTTPS — this switches on the HSTS response header (max-age=1y, includeSubDomains).
FORCES_HTTPS=false
# Optional: serve a built frontend from this directory instead of separate hosting.
STATIC_DIR=

# ── Outbox relay worker (docker-compose `outbox` service / `npm run worker`) ────
# The event spine's at-least-once delivery. REQUIRED in every environment —
# without a running worker, outbox rows are written but never relayed.
# Poll cadence, batch size, attempt cap and exponential backoff:
OUTBOX_POLL_MS=2000
OUTBOX_BATCH=20
OUTBOX_MAX_ATTEMPTS=8
OUTBOX_BACKOFF_BASE_MS=2000
OUTBOX_BACKOFF_MAX_MS=300000
# OTP policy: code lifetime (ms), max verification attempts, and the dev-only echo
# (OTP_DEV_ECHO=1 returns the code in login responses instead of sending SMS —
# refused in production; set SMS_PROVIDER to any value to disable echo).
OTP_TTL_MS=300000
OTP_MAX_ATTEMPTS=5
OTP_DEV_ECHO=1
SMS_PROVIDER=
# Dev-only demo SSO door (never on in production).
AUTH_DEV_SSO=0
# Production guard: only "strict" is allowed when NODE_ENV=production (seed refuses
# to run — seed.js truncates tenant data and installs demo credentials).
SEED_GUARD=strict

# ── Google SSO (008) ────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8080/auth/google/callback

# ── Payments (Fees §4.2) ────────────────────────────────────────────────────────
# HMAC secret for payments.upi webhooks. MUST be set while the payments.upi plugin
# is enabled — unsigned webhooks are refused without it.
UPI_WEBHOOK_SECRET=
